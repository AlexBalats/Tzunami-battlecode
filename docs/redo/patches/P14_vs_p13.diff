+// P14 Part 4: the share of the map's gem flow that gem clusters carry (gems a round over every group: each gem cluster
+// 7 gems [rules], the group's respawn its longest member's [sdk]). Clusters never hit back, so Jungle buys nothing on them
+static float cluster_share(const World& w)
+{
+    float cl = 0, all = 0;
+    for (int g = 0; g < w.nG; ++g)
+    {
+        const Group& o = w.G[g]; if (o.resp <= 0) continue;
+        int n = 0; for (int i = 0; i < o.n; ++i) if (o.kind[i] == 2) ++n;
+        cl += 7.f * n / o.resp; all += (float)o.gems / o.resp;
+    }
+    return all > 0 ? cl / all : 0.f;
+}
