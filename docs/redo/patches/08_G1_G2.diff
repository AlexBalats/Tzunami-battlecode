+def sq(ht, dt, hu, du, e0, mr, S):
+    """The square law: M3 the nearest enemy's free shots on approach, (d - 1) x the ranged side's D off the melee side's
+    H; x = H_them D_them / (H_us D_us); P(lose) = x^E / (1 + x^E)."""
