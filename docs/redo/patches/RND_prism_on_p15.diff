+bool Kit::area_camp(const World& w, const Snap& s, int g, bool moved)
+{
+    if (area_slot < 0 || moved || !s.can_cast || !ready(w, area_slot)) return false;
+    // the tile in range whose radius-1 square holds the most live monsters of my group, never one covering another group's
+    const auto ab = w.me->abilities()[area_slot];
+    const int rg = (int)ab.get<cambc::ability_aoe_damage>().range;
+    int bestn = 0; vec2 best;
+    for (int i = 0; i < s.nlive; ++i)
+    {
+        const LiveCamp& c = s.live[i];
+        if (c.hp <= 0 || c.g != g) continue;
+        for (int d = -1; d < 8; ++d)
+        {
+            const vec2 q = d < 0 ? c.p : c.p + DIRS[d];
+            if (!in_map(q) || cheb(q, s.pos) > rg) continue;
+            int n = 0; bool bad = false;
+            for (int j = 0; j < s.nlive; ++j)
+            {
+                const LiveCamp& m = s.live[j];
+                if (m.hp <= 0 || cheb(m.p, q) > 1) continue;
+                if (m.g == g) ++n; else bad = true;
+            }
+            if (!bad && n > bestn) { bestn = n; best = q; }
+        }
+    }
+    if (bestn == 0) return false;
+    try { return ab.use(best); } catch (...) { return false; }
+}
+
 bool Kit::cast_fight(const World& w, const Snap& s, const cambc::champion& target)
 {
     if (!s.can_cast) return false;
+    // P14 Prism: the area on the target's tile (it can't target a unit)
+    if (area_slot >= 0 && ready(w, area_slot)) { try { const auto ab = w.me->abilities()[area_slot]; if (cheb(target.position(), s.pos) <= (int)ab.get<cambc::ability_aoe_damage>().range && ab.use(target.position())) return true; } catch (...) {} }
     for (int slot : { fight_slot, stun_slot })
     {
         if (slot < 0 || slot == reset_slot || !ready(w, slot)) continue;
         try { if (w.me->abilities()[slot].can_target_enemies() && w.me->abilities()[slot].use(target)) return true; } catch (...) {}
     }
     return false;
+}
+
+// rnd-prism (RND_DRAFTS card PR): Willow heals the ally in range missing the most HP once it misses at least the heal's
+// amount (3 x Focus [sdk]), or any ally below HEAL_ALLY_HP in a fight; the slot had no caller
+bool Kit::heal_ally(const World& w, const Snap& s)
+{
+    if (heal_slot < 0 || !s.can_cast || !ready(w, heal_slot)) return false;
+    try
+    {
+        const auto ab = w.me->abilities()[heal_slot];
+        const auto& h = ab.get<cambc::ability_heal>();
+        const float amt = h.modifier * s.focus; const int rg = (int)h.range;
+        const Ally* best = nullptr; float bm = 0;
+        for (int i = 0; i < s.na; ++i)
+        {
+            const Ally& a = s.a[i];
+            if (a.d > rg || a.hp <= 0) continue;
+            const float miss = a.maxhp - a.hp;
+            if (miss < amt && a.hp > HEAL_ALLY_HP * a.maxhp) continue;
+            if (!best || miss > bm) { best = &a; bm = miss; }
+        }
+        if (!best) return false;
+        return ab.use(cambc::vision::champion_at(best->p));
+    }
+    catch (...) { return false; }
 }
 
 bool Kit::stun_enemy(const World& w, const Snap& s, const cambc::champion& target)
