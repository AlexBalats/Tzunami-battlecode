+}
+
+// RND_DRAFTS card PR / HL: Willow heals the ally in range missing the most HP once it misses at least the heal's
+// amount (3 x Focus [sdk]), or any ally below HEAL_ALLY_HP in a fight; the slot had no caller
+bool Kit::heal_ally(const World& w, const Snap& s)
+{
+    if (heal_slot < 0 || !s.can_cast || !ready(w, heal_slot)) return false;
+    try
+    {
+        const auto ab = w.me->abilities()[heal_slot];
+        const auto& h = ab.get<cambc::ability_heal>();
+        const float amt = h.modifier * s.focus; const int rg = (int)h.range;
+        const Ally* best = nullptr; float bm = 0;
+        for (int i = 0; i < s.na; ++i)
+        {
+            const Ally& a = s.a[i];
+            if (a.d > rg || a.hp <= 0) continue;
+            const float miss = a.maxhp - a.hp;
+            if (miss < amt && a.hp > HEAL_ALLY_HP * a.maxhp) continue;
+            if (!best || miss > bm) { best = &a; bm = miss; }
+        }
+        if (!best) return false;
+        return ab.use(cambc::vision::champion_at(best->p));
+    }
+    catch (...) { return false; }
 }
 
 bool Kit::stun_enemy(const World& w, const Snap& s, const cambc::champion& target)
