diff -ru bots/cpp/src/main.cpp bots/_t_gate2/src/main.cpp
--- bots/cpp/src/main.cpp	2026-10-24 23:13:56
+++ bots/_t_gate2/src/main.cpp	2026-10-25 00:17:55
@@ -263,6 +263,7 @@
     MEM.last_pos = S.pos; MEM.last_hp = S.hp; MEM.last_bag = S.bag; MEM.last_gold = S.gold;
     // F_home lazily when the turn has room (one field)
     if (!w.have_home && fuel() > NAV.field_cost + 5000) { bitboard vis; w.F_home.compute(w.blk, w.sp, vis, FAR - 1); w.have_home = true; }
+    else if (!w.gates_ready && fuel() > 2 * NAV.field_cost + 5000) w.gate_init();   // X8: the altar gates (the C++ port never called it: RND_P11 §4.1)
     else if (w.aw_n < w.nA && fuel() > NAV.field_cost + 5000) { w.aw_build(); TR("aw", "row %d/%d used=%llu", w.aw_n, w.nA, (unsigned long long)(f0 - fuel())); }   // then the AW rows, one a turn (ROUTING §2.3)
     const auto used = f0 - fuel();
     FSUM += used; ++FN; if (used > FMAX) FMAX = used; if (used > 99000) ++ROLL;
diff -ru bots/cpp/src/world.cpp bots/_t_gate2/src/world.cpp
--- bots/cpp/src/world.cpp	2026-10-24 22:05:12
+++ bots/_t_gate2/src/world.cpp	2026-10-25 00:17:55
@@ -179,12 +179,16 @@
     gates_ready = true;
     bitboard vis; distance_field f;
     f.compute(blk | ctiles, sp, vis, FAR - 1);
+    distance_field f0; f0.compute(blk, sp, vis, FAR - 1);   // without the camps: an altar walled off by holes alone is left to hops and the crystal
     for (int a = 0; a < nA; ++a)
     {
         ngate[a] = 0;
         bool open = false;
         for (int d = 0; d < 8 && !open; ++d) { const vec2 q = apos[a] + DIRS[d]; if (in_map(q) && !bb_get(blk, q) && df_get(f, q) < FAR) open = true; }
         if (open) continue;
+        bool camp_gated = false;   // only camps stand between: 01islands' altars sit in hole fields (RND_P11 §4.1)
+        for (int d = 0; d < 8 && !camp_gated; ++d) { const vec2 q = apos[a] + DIRS[d]; if (in_map(q) && !bb_get(blk, q) && df_get(f0, q) < FAR) camp_gated = true; }
+        if (!camp_gated) continue;
         for (int g = 0; g < nG && ngate[a] < 4; ++g)
             for (int i = 0; i < G[g].n; ++i) if (cheb(G[g].tiles[i], apos[a]) <= 2) { gate[a][ngate[a]++] = g; break; }
         if (ngate[a] == 0) { ngate[a] = 1; gate[a][0] = -1; }
