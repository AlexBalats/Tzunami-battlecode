+// TOP_P9 T2: the bank trip by recall: the recall's turns + the walk from home to the altar's ring. The winners bank via
+// spawn on 53 % of open-map trips (heal and shop on the way, 99 % shop), ours 33 %, and their trips that way are shorter
+// (14 rounds from the gain vs our 20) [measured]
+float recall_bank_walk(const World& w, int a)
+{
+    // the altar tile is blocked, so its own home-field value is FAR (walk_home falls back to a straight line through
+    // walls: banking stopped on 11 maps): the best walkable tile of its ring
+    if (!w.have_home) return (float)FAR;
+    u16 h = FAR;
+    for (int dx = -1; dx <= 1; ++dx) for (int dy = -1; dy <= 1; ++dy)
+    {
+        const vec2 q{ w.apos[a].x + dx, w.apos[a].y + dy };
+        if ((dx || dy) && q.x >= 0 && q.y >= 0 && q.x < META.W && q.y < META.H) { const u16 v = df_get(w.F_home, q); if (v < h) h = v; }
+    }
+    return h < FAR ? (float)KIT.recall_turns + h : (float)FAR;
+}
