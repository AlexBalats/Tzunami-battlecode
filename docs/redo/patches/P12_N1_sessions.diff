+// N1 (LOSSES_P10 L4): a take my HP can't finish in one go runs in sessions: hit down to the floor, step out until the
+// group sleeps, recall to heal, come back. The camps keep their damage [measured 3.0.5: 0 HP rises but respawns over 3
+// games; a damaged camp sleeps 2-3 rounds after the last champion leaves its range]. Sessions are open to a healthy body,
+// and to one hitting its farm target while it stays above the floor plus the walk out, on the team's group only while
+// it is gem-starved. Open on every group they lost head to head to the build without them (47.3 % vs its null 48.0 %;
+// LOSSES_P10 §8). 00stampede's only gems sit in a need-6 group: p10 never priced it and both copies ended 0-0 at r2000;
+// its winners took it 3-4 bodies at a time
+static float awake_str(const Snap& s, int g)
+{
+    float a = 0; for (int i = 0; i < s.nlive; ++i) if (s.live[i].g == g && s.live[i].awake && s.live[i].hp > 0) a += s.live[i].str;
+    return a;
+}
+
+bool sess_open(const Snap& s, int g)
+{
+    if (g < 0 || g != ST.gstar) return false;   // only the team's group while gem-starved (starved() below)
+    const float a = awake_str(s, g);
+    if (s.hp - WALK_OUT * a <= KEEP_HP * s.maxhp) return false;
+    return s.hp >= HEAL_NOENEMY_HP * s.maxhp || (a > 0 && ST.cur.beh == Beh::Farm && ST.cur.target == g);
+}
+
+// full-HP sessions damage d needs after the one my HP allows now (now = HP above the floor); -1 = more than SESS_MAX
+static int sessions(const Snap& s, float d, float now)
+{
+    if (d <= now) return 0;
+    const float full = (1 - KEEP_HP) * s.maxhp;
+    const int n = (int)std::ceil((d - (now > 0 ? now : 0)) / (full > 1 ? full : 1));
+    return n < SESS_MAX ? n : -1;
+}
+
+// N1: gem-starved: the draft puts under STARVE_SHARE of the map's gems in groups the roster takes in one go (draft need
+// <= roster; 13 of 40 maps, LOSSES_P10 §6b), the whole team takes the group with the most gems per HP in sessions.
+// Every body picks it from the draft's facts, so they all pick the same one. Two live triggers lost: no one-session gem
+// take priced for 50 rounds fired 2-12 times a game on every map (47.3 % head to head vs its null 48.0 %), and no gem
+// group the full team finishes at once switched off on 00stampede once the camps were hurt, so the five never met
+static void starve_check(const World& w, const Snap& s, const Mem& mem)
+{
+    (void)mem;
+    if (ST.sv_r > 0) return;   // a fact of the map: once
+    int all = 0, easy = 0;
+    for (int g = 0; g < w.nG; ++g) { const Group& o = w.G[g]; if (o.d_us >= 255) continue; all += o.gems; if (o.need <= w.nroster) easy += o.gems; }
+    ST.sv_r = s.r;
+    if (all > 0 && easy >= STARVE_SHARE * all) ST.gem_ok = 1 << 20;   // never starved
+}
+
+bool starved(const World& w, int r)
+{
+    if (r - ST.gem_ok < STARVE_R) { ST.gstar = -1; return false; }
+    if (ST.gstar < 0)
+    {
+        float bv = 0;
+        for (int g = 0; g < w.nG; ++g)
+        {
+            const Group& o = w.G[g]; if (o.gems <= 0 || o.d_us >= 255) continue;
+            // not a monolith's group: the endgame take (N4); as the team's group it lost 00monolith 9 -> 3 of 16
+            bool mono = false; for (int i = 0; i < o.n; ++i) if (o.kind[i] == 4) mono = true;
+            if (mono) continue;
+            float hp = 0; for (int i = 0; i < o.n; ++i) hp += o.hp0[i];
+            const float v = o.gems / (hp > 1 ? hp : 1);
+            if (v > bv) { bv = v; ST.gstar = g; }
+        }
+        TR("starve", "g%d since r%d", ST.gstar, ST.gem_ok);
+    }
+    return ST.gstar >= 0;
+}
