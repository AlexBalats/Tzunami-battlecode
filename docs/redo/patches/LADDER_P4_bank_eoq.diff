+// P3, P12: a carried bag counts only once banked [rules], so it is due (LADDER_P4 §10.3):
+// - at the order size B* = rho * sqrt(2 D / HOLD_H) (economic order quantity: D my added walk to bank, rho my gems per
+//   live round, HOLD_H the gems lost per carried gem per round). A rate price alone never banked a big bag: it caps at
+//   10 a round (the channel is bag / 10), and our Vesper ended a ladder loss holding 980;
+// - when it wins the game, or when the game may end (2,000 rounds, or either side's pace to 1,000) before a later bank
+static bool bank_due(const Snap& s, const Mem& mem, int chan)
+{
+    if (s.score_us + s.bag >= WIN_GEMS) return true;
+    const float rho = (mem.gain + RHO0_G) / (float)(mem.live + RHO0_R);
+    const float d = s.badd > 1 ? (float)s.badd : 1.f;
+    if ((float)s.bag >= rho * std::sqrt(2 * d / HOLD_H)) return true;
+    int left = 2000 - s.r;
+    auto eta = [&](int sc) { return sc > 0 && s.r > 0 ? (int)((WIN_GEMS - sc) * (float)s.r / sc) : 9999; };
+    if (eta(s.score_them) < left) left = eta(s.score_them);
+    if (eta(s.score_us) < left) left = eta(s.score_us);
+    return left <= s.bwk + chan + END_MARGIN;
+}
