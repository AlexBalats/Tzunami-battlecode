diff -ruN --strip-trailing-cr rnd-vcore/src/sym.h _t_sym/src/sym.h
--- rnd-vcore/src/sym.h	1970-01-01 01:00:00
+++ _t_sym/src/sym.h	2026-10-26 15:30:39
@@ -0,0 +1,71 @@
+// Side symmetry (RND_DRAFTS §6). camp_groups() comes in the same order for both teams, in mirror pairs with team A's
+// member first [measured 26 Oct: 00quarry, 00collision, 02harvest], so every "lowest index wins" tie-break in the bot
+// picked an own-side group as team A and an enemy-side one as team B: one bot, two behaviours (p13 and VC both win
+// less as team B). Team B reorders the groups so that its index i is the mirror image of team A's group i: on a
+// symmetric map both sides then see the same world and decide alike. Called by the draft and by World::boot, so the
+// draft record's group indices (open1 / open2) agree with play.
+#pragma once
+#include <cambc.h>
+#include <vector>
+
+namespace sym
+{
+// transform t (0 rotation, 1 and 2 the reflections) carries our spawn onto theirs
+inline bool spawn_fits(int t, const cambc::bitboard& sp, const cambc::bitboard& esp, int W, int H)
+{
+    const auto ps = sp.positions();
+    {
+        bool ok = !ps.empty();
+        for (const auto& p : ps)
+        {
+            const cambc::vec2 q = t == 0 ? cambc::vec2{ W - 1 - p.x, H - 1 - p.y } : t == 1 ? cambc::vec2{ W - 1 - p.x, p.y } : cambc::vec2{ p.x, H - 1 - p.y };
+            if (q.x < 0 || q.y < 0 || q.x >= W || q.y >= H || !esp.is_set(q)) { ok = false; break; }
+        }
+        return ok;
+    }
+}
+
+inline cambc::vec2 apply(int t, cambc::vec2 p, int W, int H)
+{
+    return t == 0 ? cambc::vec2{ W - 1 - p.x, H - 1 - p.y } : t == 1 ? cambc::vec2{ W - 1 - p.x, p.y } : cambc::vec2{ p.x, H - 1 - p.y };
+}
+
+// team B only: groups[i] becomes the mirror partner of the old groups[i]. Unchanged when the map has no such symmetry
+// or the partners are not one to one (the bot then plays as before)
+inline void mirror_order(std::vector<cambc::map::camp_group>& gs, int W, int H)
+{
+    if (cambc::detail::sdk_my_team() == 0 || gs.empty()) return;
+    const auto sp = cambc::map::spawn_region(cambc::team::enemy), esp = cambc::map::spawn_region(cambc::team::ally);
+    const int n = (int)gs.size();
+    std::vector<int> owner(W * H, -1);
+    std::vector<cambc::vec2> first(n, cambc::vec2{ -1, -1 });
+    for (int g = 0; g < n; ++g)
+        for (const auto& c : gs[g].camps())
+        {
+            const cambc::vec2 p = c.spawn_position();
+            if (p.x < 0 || p.y < 0 || p.x >= W || p.y >= H) continue;
+            owner[p.y * W + p.x] = g;
+            if (first[g].x < 0) first[g] = p;
+        }
+    // a spawn can fit two transforms (00quarry: rotation and the left-right reflection); the camps settle it
+    std::vector<int> partner(n, -1);
+    bool found = false;
+    for (int t = 0; t < 3 && !found; ++t)
+    {
+        if (!spawn_fits(t, sp, esp, W, H)) continue;
+        std::vector<bool> used(n, false); found = true;
+        for (int g = 0; g < n && found; ++g)
+        {
+            if (first[g].x < 0) { found = false; break; }
+            const cambc::vec2 q = apply(t, first[g], W, H);
+            const int h = q.x < 0 || q.y < 0 || q.x >= W || q.y >= H ? -1 : owner[q.y * W + q.x];
+            if (h < 0 || used[h]) { found = false; break; }
+            partner[g] = h; used[h] = true;
+        }
+    }
+    if (!found) return;
+    std::vector<cambc::map::camp_group> out; out.reserve(n);
+    for (int g = 0; g < n; ++g) out.push_back(gs[partner[g]]);
+    gs.swap(out);
+}
+} // namespace sym
