+// ---- Hunt ----
+static Status hunt(const World& w, Snap& s, Mem& mem, int a)
+{
+    if (s.ne) return Status::Done;
+    const bool grp = a >= 100;
+    if (grp ? (a - 100 >= w.nG) : (a < 0 || a >= w.nA)) return Status::Failed;
+    const vec2 t = grp ? w.G[a - 100].anchor : w.apos[a];
+    if (cheb(s.pos, t) <= 2 && (grp || w.aside[a] == 2))
+    {
+        if (grp) ST.hvis_g[a - 100] = s.r; else ST.hvis_a[a] = s.r;
+        TR("patrol", "visit %s%d", grp ? "g" : "A", grp ? a - 100 : a);
+        return Status::Done;
+    }
+    if (s.r - ST.started >= HUNT_MAX || cheb(s.pos, t) <= 2) return Status::Failed;
+    NAV.step(w, s, mem, grp ? Goal{ NavKey::Ring, a - 100 } : Goal{ NavKey::Altar, a }, NavMode::Fast);
+    return Status::Going;
