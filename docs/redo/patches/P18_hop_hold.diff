+// the walk a dash from p could skip: v(p) - the lowest field within dash range on a line clear of walls (it may cross
+// holes [rules]); terrain only (units and camps are checked at the dash itself)
+static int hop_gain(const World& w, const distance_field& f, vec2 p, int vp) {
+    int best = vp;
+    for (int dy = -dash_rng; dy <= dash_rng; ++dy)
+        for (int dx = -dash_rng; dx <= dash_rng; ++dx) {
+            const vec2 q{ p.x + dx, p.y + dy };
+            if (!in_map(q)) continue;
+            const int u = df_get(f, q);
+            if (u >= best) continue;
+            const int n = mx_(dx < 0 ? -dx : dx, dy < 0 ? -dy : dy);
+            bool ok = true;
+            for (int k = 1; k < n && ok; ++k) { const vec2 t{ p.x + (dx * k + (dx > 0 ? n / 2 : -n / 2)) / n, p.y + (dy * k + (dy > 0 ? n / 2 : -n / 2)) / n }; ok = !bb_get(w.walls, t); }
+            if (ok) best = u;
+        }
+    return vp - best;
+}
+// a step on my path before the dash would be ready again offers a hop HOP_HOLD bigger than a dash from here
+bool Nav::hop_ahead(const World& w, const distance_field& f, Goal g, vec2 pos, int v) {
+    if (dash_cd <= 1) return false;
+    const int now = hop_gain(w, f, pos, v);
+    const int ns = gpath(f, g, pos, dash_cd < PMAX ? dash_cd : PMAX);
+    for (int k = 1; k <= ns && k < dash_cd; ++k) {
+        const int vk = df_get(f, PATH[k]);
+        if (vk >= FAR) break;
+        if (hop_gain(w, f, PATH[k], vk) >= now + HOP_HOLD) return true;
+    }
+    return false;
+}
