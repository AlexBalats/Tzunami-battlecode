+// the Chebyshev distance from p to the segment a-b: the max of two |linear| terms is convex in t, so its least is at an
+// end or where a term is 0 or the two are equal
+static float seg_cheb(vec2 p, vec2 a, vec2 b)
+{
+    const float dx = (float)(b.x - a.x), dy = (float)(b.y - a.y), px = (float)(p.x - a.x), py = (float)(p.y - a.y);
+    float ts[6] = { 0, 1 }; int n = 2;
+    if (dx != 0) ts[n++] = px / dx;
+    if (dy != 0) ts[n++] = py / dy;
+    if (dx != dy) ts[n++] = (px - py) / (dx - dy);
+    if (dx != -dy) ts[n++] = (px + py) / (dx + dy);
+    float best = 1e9f;
+    for (int i = 0; i < n; ++i)
+    {
+        const float t = ts[i] < 0 ? 0 : ts[i] > 1 ? 1 : ts[i];
+        const float u = std::fabs(px - t * dx), v = std::fabs(py - t * dy), f = u > v ? u : v;
+        if (f < best) best = f;
+    }
+    return best;
+}
+
+// k: the bodies of the take at b (1 on the way)
