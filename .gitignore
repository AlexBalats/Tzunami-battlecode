# cambc caches and build outputs
.cambc/
bots/*/.cambc/
bots/*/build/
bots/*/target/

# local match outputs (tools/arena.py writes runs/arena/, cambc writes replays/; matches/ holds run-batch lists)
runs/
replays/
matches/
replays_from_others/
/*.csv
# downloaded match bundles and raw replays wherever they sit (other_stuff_for_now/fish/, tourney_top/: other teams'
# games, read by the decoders, never committed)
match-*.zip
*.repl26a

# iCloud conflict copies ("cambc 2.h", "src 2/", "compile_commands 3.json"): duplicates the sync drops beside the real file
* [0-9]
* [0-9].*

# cambc writes a per-machine compile_commands.json (absolute paths) into every bot folder
compile_commands.json

# local scratch: every bots/_* folder is a generated copy (arena NAME@REV snapshots, rollbacks, probes),
# rebuilt on demand and never committed
bots/_*/

# Python and tooling
.venv/
__pycache__/
.pytest_cache/
tools/mapgen/.cache/
.claude/
.vscode/
.DS_Store

# submissions: only the ladder entry and the bar are committed
submissions/*.zip
